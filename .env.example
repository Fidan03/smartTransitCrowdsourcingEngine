# Copy to .env and fill in real values. Never commit .env.

# development | test | production
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://smart_transit:CHANGE_ME@localhost:5432/smart_transit?sslmode=disable

# GPS simulator (must be false in production)
SIMULATOR_ENABLED=true
SIMULATOR_INTERVAL=2s
GPS_STALE_AFTER=60s
GPS_MAX_AGE=15m

# Crowding and alerts. ALERT_SUSTAIN may be shortened ONLY outside production
# (e.g. 2m for a quick demo); production always enforces 10m.
ALERT_SUSTAIN=10m
CROWD_EVAL_INTERVAL=15s
REPORT_DUP_INTERVAL=2m

# HMAC key for anonymous submitter keys (16+ chars; required in production)
REPORT_KEY_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Operator account created on startup if missing (password: 12+ chars)
OPERATOR_EMAIL=operator@example.com
OPERATOR_PASSWORD=CHANGE_ME_LONG_PASSWORD

# Integration tests: a SEPARATE database whose name ends in _test (wiped on each run)
TEST_DATABASE_URL=postgres://smart_transit:CHANGE_ME@localhost:5432/smart_transit_test?sslmode=disable
